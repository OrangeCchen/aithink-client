{
  "name": "aithink",
  "version": "0.1.0",
  "description": "AIThink - 基于 Electron + Vue 3 的 AI 桌面客户端（自研 AgentRuntime）",
  "main": "dist-electron/electron/main.js",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k -n vite,electron \"npm:dev:frontend\" \"npm:dev:electron\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:electron": "tsc -p tsconfig.node.json && wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .",
    "build:electron": "tsc -p tsconfig.node.json",
    "build:frontend": "cd frontend && npm run build",
    "build": "npm run build:electron && npm run build:frontend",
    "package": "npm run build && electron-builder"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "whisper-cpp-node": "^0.2.12"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.0.2",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3",
    "wait-on": "^8.0.1"
  }
}
